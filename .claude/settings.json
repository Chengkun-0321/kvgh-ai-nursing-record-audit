{
  "permissions": {
    "allow": [
      "Bash(bash .claude/flow/flow_init.sh)",
      "Bash(bash .claude/flow/run_tests.sh:*)",
      "Bash(bash .claude/flow/finish.sh)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\" main" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/capture_report.py\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_guard.py\"" }
        ]
      }
    ]
  }
}
