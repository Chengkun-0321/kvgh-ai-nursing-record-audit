# 複製為 .env 後填入實際值；.env 不進版控
# Docker 部署時，資料與憑證路徑由 Compose 覆寫，CORS 預設 []（nginx 同源）；詳見 docs/deployment-docker.md。

# 資料庫：開發預設為 backend/data/app.db（SQLite）；正式環境改為 postgresql+asyncpg://…
# DATABASE_URL=sqlite+aiosqlite:////絕對路徑/backend/data/app.db

# 本機開發允許的跨來源前端（JSON 陣列）；Docker 特殊情境由根目錄 CORS_ALLOWED_ORIGINS 覆寫。
CORS_ORIGINS=["http://localhost:3000"]

# LLM API key 加密金鑰（Fernet）。產生方式：
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 更換後已儲存的 API key 將無法解密，需重新輸入
LLM_KEY_ENCRYPTION_KEY=

# Demo 登入帳密（必填，未設定時後端無法啟動）。僅供展示用的固定帳號，不是正式的權限機制；
# 此檔進版控，不得填入真實密碼，請只在本機或主機的 .env 設定
DEMO_LOGIN_USERNAME=
DEMO_LOGIN_PASSWORD=
# 登入有效秒數（預設 43200＝12 小時），到期後需重新登入
SESSION_MAX_AGE_SECONDS=43200

# 模型設定未填逾時秒數時的預設值
LLM_DEFAULT_TIMEOUT_SECONDS=60
# 測試對話失敗時的重試次數（預設不重試，錯誤立即顯示）
LLM_CHAT_NUM_RETRIES=0
# 稽核結果格式不符（非合法 JSON 或不符 schema）時的重試次數，不含第一次呼叫
LLM_MAX_RETRIES=2
# 稽核呼叫遇到網路錯誤、429、逾時的重試次數，與格式重試分開計算
LLM_STRUCTURED_NUM_RETRIES=2
# 同時進行中的結構化 LLM 呼叫數（一鍵稽核時多張卡片同時送出）
LLM_MAX_CONCURRENCY=3

# 稽核 R02：複製比對回溯天數，含當日（預設 5＝當日加前 4 日）
AUDIT_COPY_LOOKBACK_DAYS=5
# 稽核 R06：會診後幾日內要有相應紀錄（暫定，院方待確認）
AUDIT_CONSULT_FOLLOWUP_DAYS=1

# ChatGPT 訂閱登入的 token 目錄（含登入憑證，必須在不進版控的 data/ 內）
# CHATGPT_TOKEN_DIR=/絕對路徑/backend/data/chatgpt

# 查詢 ChatGPT 帳號可用模型時帶的 Codex 用戶端版本（client_version）；版本太舊時新模型不會列出。
# 優先順序：CHATGPT_CLIENT_VERSION → 自動查詢的最新版本 → CHATGPT_CLIENT_VERSION_FALLBACK
# 固定使用此版本（不設定則自動查詢；僅在自動查詢的版本有問題時才設定）
# CHATGPT_CLIENT_VERSION=0.159.2
# 自動查詢失敗（離線、逾時、格式錯誤）時使用的版本
# CHATGPT_CLIENT_VERSION_FALLBACK=0.159.2
# 查詢 Codex CLI 最新版本的位址（npm registry 的 @openai/codex latest）
# CODEX_LATEST_VERSION_URL=https://registry.npmjs.org/@openai/codex/latest
# 查到的版本快取秒數（預設一天）
# CODEX_VERSION_CACHE_SECONDS=86400

# 院方每日資料目錄（內含 <YYYYMMDD>/<病房>/patientlist.json 與病人檔；後端只讀不寫）
# HOSPITAL_DATA_DIR=/絕對路徑/data
# 首頁與原始資料頁預設顯示的病房
# DEFAULT_WARD_CODE=W63
