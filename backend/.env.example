# 複製為 .env 後填入實際值；.env 不進版控

# 資料庫：開發預設為 backend/data/app.db（SQLite）；正式環境改為 postgresql+asyncpg://…
# DATABASE_URL=sqlite+aiosqlite:////絕對路徑/backend/data/app.db

# 允許呼叫 API 的前端來源（JSON 陣列）
CORS_ORIGINS=["http://localhost:3000"]

# LLM API key 加密金鑰（Fernet）。產生方式：
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 更換後已儲存的 API key 將無法解密，需重新輸入
LLM_KEY_ENCRYPTION_KEY=

# 模型設定未填逾時秒數時的預設值
LLM_DEFAULT_TIMEOUT_SECONDS=60
# 測試對話失敗時的重試次數（預設不重試，錯誤立即顯示）
LLM_CHAT_NUM_RETRIES=0

# ChatGPT 訂閱登入的 token 目錄（含登入憑證，必須在不進版控的 data/ 內）
# CHATGPT_TOKEN_DIR=/絕對路徑/backend/data/chatgpt

# 查詢 ChatGPT 帳號可用模型時帶的 Codex 用戶端版本（client_version）；版本太舊時新模型不會列出。
# 優先順序：CHATGPT_CLIENT_VERSION → 自動查詢的最新版本 → CHATGPT_CLIENT_VERSION_FALLBACK
# 固定使用此版本（不設定則自動查詢；僅在自動查詢的版本有問題時才設定）
# CHATGPT_CLIENT_VERSION=0.159.2
# 自動查詢失敗（離線、逾時、格式錯誤）時使用的版本
# CHATGPT_CLIENT_VERSION_FALLBACK=0.159.2
# 查詢 Codex CLI 最新版本的位址（npm registry 的 @openai/codex latest）
# CODEX_LATEST_VERSION_URL=https://registry.npmjs.org/@openai/codex/latest
# 查到的版本快取秒數（預設一天）
# CODEX_VERSION_CACHE_SECONDS=86400
