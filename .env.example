# 複製為根目錄 .env，供 Docker Compose 插值；後端機密另放 backend/.env。

# 對外唯一入口連接埠（nginx），預設 3000；容器內固定 8080。例：FRONTEND_PORT=25300
FRONTEND_PORT=3000

# 通常不需設定：瀏覽器透過 nginx 同源呼叫，留空預設 []。
# 特殊跨來源情境才覆寫為 JSON 陣列，精確列出協定、主機與連接埠，不得使用 *。
# 例：CORS_ALLOWED_ORIGINS='["https://audit.example.org"]'
CORS_ALLOWED_ORIGINS=

# SQLite 與 ChatGPT token 的主機目錄，預設 ./backend/data；須可供後端 UID 寫入。
BACKEND_DATA_DIR=./backend/data
# 院方資料的主機目錄，預設 ./data；唯讀掛載，須可供後端 UID 讀取。
HOSPITAL_DATA_HOST_DIR=./data

# 後端映像執行帳號，預設 UID/GID 都是 1000；建議填 Linux 部署帳號的 id -u / id -g。
# 修改後必須重新 build 後端；前端固定以映像內的 node 帳號執行。
APP_UID=1000
APP_GID=1000
