# 複製為根目錄 .env，供 Docker Compose 插值；後端機密另放 backend/.env。

# 主機前端連接埠，預設 3000；容器內固定 3000。
FRONTEND_PORT=3000
# 主機後端連接埠，預設 8000；容器內固定 8000。
BACKEND_PORT=8000

# 瀏覽器使用的後端位址；留空預設 http://localhost:${BACKEND_PORT:-8000}。
# 遠端連線例：http://192.168.1.20:8000；不含 /api/v1，末尾不要加斜線。
# 修改此值或預設所用的 BACKEND_PORT 後，必須重新 build 前端。
PUBLIC_API_BASE_URL=
# 允許的瀏覽器來源，JSON 陣列、不得使用 *；留空隨 FRONTEND_PORT 預設。
# 預設 ["http://localhost:${FRONTEND_PORT:-3000}"]；覆寫時須自行同步連接埠。
# 遠端連線例：CORS_ALLOWED_ORIGINS='["http://192.168.1.20:3000"]'
CORS_ALLOWED_ORIGINS=

# SQLite 與 ChatGPT token 的主機目錄，預設 ./backend/data；須可供後端 UID 寫入。
BACKEND_DATA_DIR=./backend/data
# 院方資料的主機目錄，預設 ./data；唯讀掛載，須可供後端 UID 讀取。
HOSPITAL_DATA_HOST_DIR=./data

# 後端映像執行帳號，預設 UID/GID 都是 1000；建議填 Linux 部署帳號的 id -u / id -g。
# 修改後必須重新 build 後端；前端固定以映像內的 node 帳號執行。
APP_UID=1000
APP_GID=1000
